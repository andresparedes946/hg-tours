# Copiar como .env.local para desarrollo, o cargar en Vercel → Settings → Environment Variables.

# Dominio público definitivo, sin barra final (ej. https://www.hgtours.com.ar).
# Habilita la URL canónica, el sitemap y las URLs absolutas de Open Graph.
# Si queda vacío, en Vercel se usa automáticamente la URL de producción del proyecto.
NEXT_PUBLIC_SITE_URL=
